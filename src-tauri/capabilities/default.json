{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by the Taskloom desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "python3", "cmd": "python3", "args": true }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
