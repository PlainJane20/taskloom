{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskloom",
  "version": "0.7.1",
  "identifier": "dev.taskloom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Taskloom", "width": 1440, "height": 900, "minWidth": 980, "minHeight": 680 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine/main.py": "engine/main.py",
      "../engine/mcp_server.py": "engine/mcp_server.py",
      "../engine/providers.py": "engine/providers.py",
      "../requirements-mcp.txt": "requirements-mcp.txt"
    }
  }
}
